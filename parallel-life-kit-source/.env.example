# Copy to .env locally. Never commit the real .env or paste keys into the UI.
# Production uses real providers only. There is no mock runtime mode.
PARALLEL_LIFE_MODE=live
PARALLEL_LIFE_DATA_DIR=data

# Text: interview, branch initialization, decisions, replies and chapters.
PARALLEL_LIFE_CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PARALLEL_LIFE_CHAT_API_KEY=
PARALLEL_LIFE_CHAT_MODEL=doubao-seed-2-0-lite-260215

# Optional dialogue-only model or endpoint ID; uses CHAT URL/key.
# Blank keeps CHAT_MODEL. Errors are explicit, with no automatic model fallback.
# Character access/protocol must pass a live test before enabling it here.
PARALLEL_LIFE_REPLY_MODEL=
# Candidate: doubao-seed-character-260628 (account access required)

# Optional separate memory backend. Omit these to reuse CHAT settings.
# PARALLEL_LIFE_MEMORY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# PARALLEL_LIFE_MEMORY_API_KEY=
# PARALLEL_LIFE_MEMORY_MODEL=doubao-seed-2-0-lite-260215

# Image backend has independent credentials/configuration.
PARALLEL_LIFE_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PARALLEL_LIFE_IMAGE_API_KEY=
PARALLEL_LIFE_IMAGE_MODEL=doubao-seedream-4-5-251128

PARALLEL_LIFE_IMAGE_COOLDOWN=300
PARALLEL_LIFE_IMAGE_DAILY_LIMIT=10
PARALLEL_LIFE_CONTEXT_CHARS=24000
PARALLEL_LIFE_REQUEST_TIMEOUT=120

# Optional launcher port. Export in the shell for manage.py and serve.py alike.
# export PARALLEL_LIFE_PORT=8108

# One bounded factual/style edit after each character draft (uses CHAT model).
# This reduces hallucinations; it is not a guarantee of factual correctness.
PARALLEL_LIFE_DIALOGUE_REVIEW=1
# Opt in to unsolicited scene illustrations. Same budgets as requested images.
PARALLEL_LIFE_PROACTIVE_IMAGES=0
