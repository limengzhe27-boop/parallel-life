# Server only. Copy to .env.local. Never prefix credentials with NEXT_PUBLIC_.
YIBU_API_KEY=
YIBU_BASE_URL=https://yibuapi.com
YIBU_TEXT_MODEL=gpt-4o-mini
# npm run db:local fills the following local values. Never reuse another project's database.
DATABASE_URL=
SCHEDULER_DATABASE_URL=
CRON_SECRET=
# Dedicated runtime roles; never use a PostgreSQL admin account in Web/Worker.
WORKER_DATABASE_URL=
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:3218
PRIVATE_ASSET_DIR=
# Optional production object storage. Keep this key server-only.
SUPABASE_URL=
# Supabase's current server-only key. Keep the legacy name below for compatibility.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-assets
